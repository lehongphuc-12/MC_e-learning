# ==============================================================================
# MSEEK E-LEARNING - ENVIRONMENT CONFIGURATION TEMPLATE (DOCKER DEPLOYMENT)
# Huong dan: Copy file nay thanh .env tren VPS va dien cac thong tin thuc te
# Lenh tren VPS: cp .env.example .env
# ==============================================================================

# --- MANG & DOMAIN ---
# Neu co ten mien: dien https://tenmien.com. Neu dung IP VPS: dien http://<IP_VPS>
CLIENT_URL=http://localhost
CORS_EXTRA_ORIGIN=http://localhost:3000

# Port public tren VPS (Mac dinh Frontend Nginx nhan port 80)
FRONTEND_PORT=80
BACKEND_PORT=5239
MENTORCHAT_PORT=8000

# Endpoint API ma Frontend se goi (Mac dinh /api thong qua Nginx Reverse Proxy)
VITE_API_BASE_URL=/api

# --- DATABASE CONNECTION (PostgreSQL / Supabase) ---
# Dien chuoi ket noi PostgreSQL hoac Supabase Cloud Pooler cua ban:
DATABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_project_ref;Password=your_supabase_password_here;SSL Mode=Require

# (Tuy chon neu dung container Postgres local tren VPS bang profile local-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_local_postgres_password
POSTGRES_DB=mseek_db
POSTGRES_PORT=5432

# --- JWT AUTHENTICATION ---
# Chuoi bi mat JWT (toi thieu 32 ky tu, ngau nhien, an toan)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_here
JWT_ISSUER=http://localhost:5241
JWT_AUDIENCE=http://localhost:5241
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_DAYS=7

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- EMAIL SETTINGS (SMTP Gmail) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_NAME=MSEEK Support
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# --- CLOUDINARY (Media / Images) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- PAYOS (Payment Gateway) ---
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3000/payment-result
PAYOS_CANCEL_URL=http://localhost:3000/payment-result
PAYOS_WEBHOOK_URL=https://your-domain.com/api/v1/payments/payos-webhook

# --- VNPAY (Payment Gateway) ---
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5239/api/v1/payments/vnpay-return
VNPAY_FRONTEND_RESULT_URL=http://localhost:3000/payment-result

# --- CLOUDFLARE R2 (Video Storage) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=mseek-videos
R2_SERVICE_URL=https://your_account_id.r2.cloudflarestorage.com

# --- GROQ (Whisper Speech-to-Text) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3

# --- OPENAI / AI PORTAL API (Assessment & Chat) ---
OPENAI_MODEL=GPT-6-Luna
OPENAI_BASE_URL=https://aiportalapi.stu-platform.live/use
OPENAI_API_KEY=your_openai_or_portal_api_key_here
OPENAI_TIMEOUT=90

# --- VOICE ASSESSMENT AI ---
VOICE_ASSESSMENT_BASE_URL=https://nozero23061311-mseek-v4b-pronunciation-api.hf.space

# --- MC_MENTORCHAT SETTINGS ---
# Key xac thuc noi bo giua MC_BE va MC_MentorChat (dat chuoi ngau nhien manh)
MENTORCHAT_INTERNAL_API_KEY=your_random_internal_api_key_here
LLM_PROVIDER=portal
PORTAL_BASE_URL=https://aiportalapi.stu-platform.live/jpe
PORTAL_API_KEY=your_portal_api_key_here
PORTAL_MODEL=Claude-Opus-4.5
PORTAL_MAX_TOKENS=1024

GEMINI_API_KEY=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=course_knowledge
VECTOR_SIZE=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
MIN_RELEVANCE_SCORE=0.48
